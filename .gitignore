# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
*.launch
.settings/

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

*.log
Thumbs.db

# System files
.DS_Store

# Nx / Angular caches
.angular/cache
.nx/cache
.nx/workspace-data

# Stray build logs
build-output.txt
build.log

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Infrastructure — filled-in environment/secret files (see
# infrastructure/environments/.env.example and infrastructure/docs/secrets-guide.md)
infrastructure/environments/.env
infrastructure/environments/.env.local
infrastructure/**/terraform.tfvars
infrastructure/**/.terraform/
infrastructure/**/*.tfstate
infrastructure/**/*.tfstate.*

# Capacitor native shells — android/ and ios/ project files ARE committed (see
# docs/mobile/CAPACITOR.md), only their local build/tooling output and signing secrets are not.
apps/*/android/local.properties
apps/*/android/.gradle/
apps/*/android/**/build/
apps/*/android/captures/
apps/*/android/*.iml
apps/*/android/**/*.iml
apps/*/android/keystore.properties
apps/*/android/**/*.keystore
apps/*/android/**/*.jks
apps/*/ios/exportOptions.plist
apps/*/ios/App/Pods/
apps/*/ios/App/build/
apps/*/ios/App/DerivedData/
apps/*/ios/**/*.xcuserstate
apps/*/ios/**/xcuserdata/
apps/*/ios/App/App/public/
apps/*/android/app/src/main/assets/public/
infrastructure/**/crash.log
