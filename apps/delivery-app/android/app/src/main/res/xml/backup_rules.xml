<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 (API < 31) fallback for data_extraction_rules.xml — same exclusions, older
     syntax. Android applies whichever of the two files matches the device's API level.

     Parity note (M1): mirrors customer-app's rules exactly. `cap_sec` is
     capacitor-secure-storage-plugin's SharedPreferences filename, hardcoded by the plugin itself
     (PasswordStorageHelper.PREFERENCES_FILE) — identical across every app using it, not something
     that varies per applicationId, so this exclusion is correct here without modification.
     Courier location updates (AUDIT-016) are transmitted live and never persisted locally, so
     there is no additional delivery-app-specific storage to exclude. -->
<full-backup-content>
    <exclude domain="sharedpref" path="cap_sec.xml" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
