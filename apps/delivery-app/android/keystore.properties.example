# Copy this file to `keystore.properties` (gitignored) in the same directory and fill in the
# real values from your release keystore. Never commit the real file or the .jks/.keystore itself.
# CI can instead set PATHEYA_ANDROID_KEYSTORE_FILE / _KEYSTORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD.
# Release builds (assembleRelease/bundleRelease) FAIL without these — there is no debug-key fallback
# (tools/mobile/android/release-signing.gradle). A relative storeFile resolves against android/app/.
storeFile=../patheya-express-delivery-release.jks
storePassword=CHANGE_ME
keyAlias=patheya-express-delivery
keyPassword=CHANGE_ME
